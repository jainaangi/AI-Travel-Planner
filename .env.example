# ------------------------------------------------------------------
# AI Travel Planner - Environment Variables
# Copy this file to ".env" and fill in your own API keys.
# The app works without any keys, using built-in fallback logic.
# ------------------------------------------------------------------

# Google Gemini API key - used for AI-generated itineraries and chatbot.
# Get one at: https://aistudio.google.com/app/apikey
# If left empty, the app automatically uses a rule-based itinerary generator.
GEMINI_API_KEY=

# OpenWeatherMap API key - used for live weather forecasts.
# Get one at: https://openweathermap.org/api
# If left empty, the app automatically uses a seasonal weather estimate.
OPENWEATHER_API_KEY=
